<form class="public-access sheet actor player-sheet" autocomplete="off">

  <header class="forum-topbar">
    <div class="forum-logo">★ PUBLIC ACCESS ★</div>
    <div class="forum-nav">
      <span class="nav-link">{{localize "PUBLIC_ACCESS.Nav.Home"}}</span>
      <span class="nav-sep">»</span>
      <span class="nav-link">{{localize "PUBLIC_ACCESS.Nav.Characters"}}</span>
      <span class="nav-sep">»</span>
      <span class="nav-current">{{localize "PUBLIC_ACCESS.Nav.ViewProfile"}}</span>
    </div>
  </header>

  <div class="thread-title-bar">
    <span class="thread-icon">📌</span>
    <input class="thread-title-input" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'PUBLIC_ACCESS.Header.CharacterNamePlaceholder'}}" />
  </div>

  <div class="forum-post">

    <div class="user-panel">
      <div class="avatar-frame">
        <img class="avatar" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </div>

      <div class="username">{{actor.name}}</div>
      <div class="user-title">{{localize "PUBLIC_ACCESS.Header.UserTitle"}}</div>
      <div class="user-stars">★★★☆☆</div>

      <div class="user-info-table">
        <div class="info-row">
          <span class="info-label">{{localize "PUBLIC_ACCESS.Fields.Species"}}</span>
          <input type="text" name="system.species" value="{{system.species}}" placeholder="—" />
        </div>
        <div class="info-row">
          <span class="info-label">{{localize "PUBLIC_ACCESS.Fields.Style"}}</span>
          <input type="text" name="system.style" value="{{system.style}}" placeholder="—" />
        </div>
      </div>

      <div class="user-online">
        <span class="online-dot"></span> {{localize "PUBLIC_ACCESS.Header.Online"}}
      </div>
    </div>

    <div class="post-content">
      <div class="post-header">
        <span class="post-date">{{localize "PUBLIC_ACCESS.Header.PostedToday"}}</span>
        <span class="post-number">#1</span>
      </div>

      <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="main" data-group="primary">» {{localize "PUBLIC_ACCESS.Tabs.Character"}}</a>
        <a class="item" data-tab="notes" data-group="primary">» {{localize "PUBLIC_ACCESS.Tabs.Notes"}}</a>
      </nav>

      <section class="sheet-body">

        {{!-- ═══ MAIN TAB ═══ --}}
        <div class="tab main" data-group="primary" data-tab="main">

          {{!-- Stats --}}
          <div class="section-header"><span>─── ★ {{localize "PUBLIC_ACCESS.Sections.Stats"}} ★ ───</span></div>
          <div class="stats-row">
            <div class="stat-box">
              <input type="number" name="system.stats.vitality" value="{{system.stats.vitality}}" />
              <span class="stat-label rollable" data-stat="vitality" data-label="{{localize 'PUBLIC_ACCESS.Stats.Vitality'}}"
                    title="{{localize 'PUBLIC_ACCESS.Stats.RollHint'}}">
                {{localize "PUBLIC_ACCESS.Stats.Vitality"}}
              </span>
            </div>
            <div class="stat-box">
              <input type="number" name="system.stats.composure" value="{{system.stats.composure}}" />
              <span class="stat-label rollable" data-stat="composure" data-label="{{localize 'PUBLIC_ACCESS.Stats.Composure'}}"
                    title="{{localize 'PUBLIC_ACCESS.Stats.RollHint'}}">
                {{localize "PUBLIC_ACCESS.Stats.Composure"}}
              </span>
            </div>
            <div class="stat-box">
              <input type="number" name="system.stats.reason" value="{{system.stats.reason}}" />
              <span class="stat-label rollable" data-stat="reason" data-label="{{localize 'PUBLIC_ACCESS.Stats.Reason'}}"
                    title="{{localize 'PUBLIC_ACCESS.Stats.RollHint'}}">
                {{localize "PUBLIC_ACCESS.Stats.Reason"}}
              </span>
            </div>
            <div class="stat-box">
              <input type="number" name="system.stats.presence" value="{{system.stats.presence}}" />
              <span class="stat-label rollable" data-stat="presence" data-label="{{localize 'PUBLIC_ACCESS.Stats.Presence'}}"
                    title="{{localize 'PUBLIC_ACCESS.Stats.RollHint'}}">
                {{localize "PUBLIC_ACCESS.Stats.Presence"}}
              </span>
            </div>
            <div class="stat-box">
              <input type="number" name="system.stats.sensitivity" value="{{system.stats.sensitivity}}" />
              <span class="stat-label rollable" data-stat="sensitivity" data-label="{{localize 'PUBLIC_ACCESS.Stats.Sensitivity'}}"
                    title="{{localize 'PUBLIC_ACCESS.Stats.RollHint'}}">
                {{localize "PUBLIC_ACCESS.Stats.Sensitivity"}}
              </span>
            </div>
          </div>

          {{!-- Takes You Back + Conditions side-by-side --}}
          <div class="two-columns">
            <div class="column">
              <div class="section-header"><span>★ {{localize "PUBLIC_ACCESS.Sections.TakesYouBack"}} ★</span></div>
              <div class="takes-you-back">
                {{#each system.takes_you_back}}
                <div class="memory-row">
                  <span class="memory-icon">◈</span>
                  <input type="text" name="system.takes_you_back.{{@index}}" value="{{this}}" placeholder="{{localize 'PUBLIC_ACCESS.TakesYouBack.Placeholder'}}" />
                </div>
                {{/each}}
              </div>
            </div>
            <div class="column">
              <div class="section-header"><span>★ {{localize "PUBLIC_ACCESS.Sections.Conditions"}} ★</span></div>
              <div class="conditions-list">
                <div class="condition-row">
                  <span class="condition-icon">⚠</span>
                  <input type="text" name="system.condition_1" value="{{system.condition_1}}" placeholder="—" />
                </div>
                <div class="condition-row">
                  <span class="condition-icon">⚠</span>
                  <input type="text" name="system.condition_2" value="{{system.condition_2}}" placeholder="—" />
                </div>
                <div class="condition-row">
                  <span class="condition-icon">⚠</span>
                  <input type="text" name="system.condition_3" value="{{system.condition_3}}" placeholder="—" />
                </div>
              </div>
            </div>
          </div>

          {{!-- Keys (left) + XP & Advancements (right) --}}
          <div class="two-columns keys-progress">
            <div class="column">
              <div class="section-header"><span>★ {{localize "PUBLIC_ACCESS.Sections.KeyOfChild"}} ★</span></div>
              <div class="checklist">
                <label class="checklist-item">
                  <input type="checkbox" name="system.key_of_child.kc1" {{checked system.key_of_child.kc1}} />
                  <span>{{localize "PUBLIC_ACCESS.KeyOfChild.kc1"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.key_of_child.kc2" {{checked system.key_of_child.kc2}} />
                  <span>{{localize "PUBLIC_ACCESS.KeyOfChild.kc2"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.key_of_child.kc3" {{checked system.key_of_child.kc3}} />
                  <span>{{localize "PUBLIC_ACCESS.KeyOfChild.kc3"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.key_of_child.kc4" {{checked system.key_of_child.kc4}} />
                  <span>{{localize "PUBLIC_ACCESS.KeyOfChild.kc4"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.key_of_child.kc5" {{checked system.key_of_child.kc5}} />
                  <span>{{localize "PUBLIC_ACCESS.KeyOfChild.kc5"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.key_of_child.kc6" {{checked system.key_of_child.kc6}} />
                  <span>{{localize "PUBLIC_ACCESS.KeyOfChild.kc6"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.key_of_child.kc7" {{checked system.key_of_child.kc7}} />
                  <span>{{localize "PUBLIC_ACCESS.KeyOfChild.kc7"}}</span>
                </label>
              </div>

              <div class="section-header"><span>★ {{localize "PUBLIC_ACCESS.Sections.DesolationKey"}} ★</span></div>
              <div class="checklist desolation">
                <label class="checklist-item">
                  <input type="checkbox" name="system.desolation_key.dk1" {{checked system.desolation_key.dk1}} />
                  <span><strong>{{localize "PUBLIC_ACCESS.DesolationKey.dk1Name"}}</strong> {{localize "PUBLIC_ACCESS.DesolationKey.dk1Text"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.desolation_key.dk2" {{checked system.desolation_key.dk2}} />
                  <span><strong>{{localize "PUBLIC_ACCESS.DesolationKey.dk2Name"}}</strong> {{localize "PUBLIC_ACCESS.DesolationKey.dk2Text"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.desolation_key.dk3" {{checked system.desolation_key.dk3}} />
                  <span><strong>{{localize "PUBLIC_ACCESS.DesolationKey.dk3Name"}}</strong> {{localize "PUBLIC_ACCESS.DesolationKey.dk3Text"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.desolation_key.dk4" {{checked system.desolation_key.dk4}} />
                  <span><strong>{{localize "PUBLIC_ACCESS.DesolationKey.dk4Name"}}</strong> {{localize "PUBLIC_ACCESS.DesolationKey.dk4Text"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.desolation_key.dk5" {{checked system.desolation_key.dk5}} />
                  <span><strong>{{localize "PUBLIC_ACCESS.DesolationKey.dk5Name"}}</strong> {{localize "PUBLIC_ACCESS.DesolationKey.dk5Text"}}</span>
                </label>
              </div>
            </div>

            <div class="column">
              <div class="section-header"><span>★ {{localize "PUBLIC_ACCESS.Sections.XP"}} ★</span></div>
              <div class="xp-track">
                <div class="xp-boxes">
                  <label class="xp-box"><input type="checkbox" name="system.xp.xp1" {{checked system.xp.xp1}} /><span></span></label>
                  <label class="xp-box"><input type="checkbox" name="system.xp.xp2" {{checked system.xp.xp2}} /><span></span></label>
                  <label class="xp-box"><input type="checkbox" name="system.xp.xp3" {{checked system.xp.xp3}} /><span></span></label>
                  <label class="xp-box"><input type="checkbox" name="system.xp.xp4" {{checked system.xp.xp4}} /><span></span></label>
                  <label class="xp-box"><input type="checkbox" name="system.xp.xp5" {{checked system.xp.xp5}} /><span></span></label>
                </div>
              </div>

              <div class="section-header"><span>★ {{localize "PUBLIC_ACCESS.Sections.Advancements"}} ★</span></div>
              <div class="checklist">
                <label class="checklist-item">
                  <input type="checkbox" name="system.advancements.adv1" {{checked system.advancements.adv1}} />
                  <span>{{localize "PUBLIC_ACCESS.Advancements.IncreaseStat"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.advancements.adv2" {{checked system.advancements.adv2}} />
                  <span>{{localize "PUBLIC_ACCESS.Advancements.IncreaseStat"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.advancements.adv3" {{checked system.advancements.adv3}} />
                  <span>{{localize "PUBLIC_ACCESS.Advancements.ExtraMove"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.advancements.adv4" {{checked system.advancements.adv4}} />
                  <span>{{localize "PUBLIC_ACCESS.Advancements.ExtraMove"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.advancements.adv5" {{checked system.advancements.adv5}} />
                  <span>{{localize "PUBLIC_ACCESS.Advancements.WriteMove"}}</span>
                </label>
                <label class="checklist-item">
                  <input type="checkbox" name="system.advancements.adv6" {{checked system.advancements.adv6}} />
                  <span>{{localize "PUBLIC_ACCESS.Advancements.ClearCorner"}}</span>
                </label>
              </div>

              <div class="section-header">
                <span>★ {{localize "PUBLIC_ACCESS.Sections.Corner"}} ★</span>
                <button type="button" class="corner-add" title="{{localize 'PUBLIC_ACCESS.Corner.Add'}}">+</button>
              </div>
              <div class="corner-grid">
                {{#each cornerItems}}
                <div class="corner-item {{#if this.system.crossed}}is-crossed{{/if}}" data-item-id="{{this.id}}">
                  <input type="checkbox" class="corner-cross" {{checked this.system.crossed}} title="{{localize 'PUBLIC_ACCESS.Corner.Cross'}}" />
                  <input type="text" value="{{this.name}}" placeholder="{{localize 'PUBLIC_ACCESS.Corner.Placeholder'}}" class="corner-name" />
                  <button type="button" class="corner-delete" title="{{localize 'PUBLIC_ACCESS.Corner.Remove'}}">✕</button>
                </div>
                {{/each}}
                {{#unless cornerItems.length}}
                <p class="no-items-hint">{{localize "PUBLIC_ACCESS.Corner.Empty"}}</p>
                {{/unless}}
              </div>
            </div>
          </div>

          {{!-- Dawn Questions --}}
          <div class="section-header"><span>─── ★ {{localize "PUBLIC_ACCESS.Sections.DawnQuestions"}} ★ ───</span></div>
          <p class="section-hint">{{localize "PUBLIC_ACCESS.DawnQuestions.Hint"}}</p>
          <div class="checklist">
            <label class="checklist-item">
              <input type="checkbox" name="system.dawn_questions.dq1" {{checked system.dawn_questions.dq1}} />
              <span>{{localize "PUBLIC_ACCESS.DawnQuestions.dq1"}}</span>
            </label>
            <label class="checklist-item">
              <input type="checkbox" name="system.dawn_questions.dq2" {{checked system.dawn_questions.dq2}} />
              <span>{{localize "PUBLIC_ACCESS.DawnQuestions.dq2"}} <em>{{localize "PUBLIC_ACCESS.DawnQuestions.dq2Locked"}}</em></span>
            </label>
            <label class="checklist-item">
              <input type="checkbox" name="system.dawn_questions.dq3" {{checked system.dawn_questions.dq3}} />
              <span>{{localize "PUBLIC_ACCESS.DawnQuestions.dq3"}}</span>
            </label>
            <label class="checklist-item">
              <input type="checkbox" name="system.dawn_questions.dq4" {{checked system.dawn_questions.dq4}} />
              <span>{{localize "PUBLIC_ACCESS.DawnQuestions.dq4"}}</span>
            </label>
            <label class="checklist-item">
              <input type="checkbox" name="system.dawn_questions.dq5" {{checked system.dawn_questions.dq5}} />
              <span>{{localize "PUBLIC_ACCESS.DawnQuestions.dq5"}}</span>
            </label>
            <label class="checklist-item">
              <input type="checkbox" name="system.dawn_questions.dq6" {{checked system.dawn_questions.dq6}} />
              <span>{{localize "PUBLIC_ACCESS.DawnQuestions.dq6"}}</span>
            </label>
            <label class="checklist-item">
              <input type="checkbox" name="system.dawn_questions.dq7" {{checked system.dawn_questions.dq7}} />
              <span>{{localize "PUBLIC_ACCESS.DawnQuestions.dq7"}}</span>
            </label>
          </div>

          {{!-- Moves --}}
          <div class="section-header">
            <span>─── ★ {{localize "PUBLIC_ACCESS.Sections.Moves"}} ★ ───</span>
            <button type="button" class="move-add" title="{{localize 'PUBLIC_ACCESS.Moves.Add'}}">+</button>
          </div>
          <div class="moves-list">
            {{#each moves}}
            <div class="move-item" data-item-id="{{this.id}}">
              <div class="move-header">
                <span class="move-name">▸ {{this.name}}</span>
                <div class="move-controls">
                  <button type="button" class="item-edit" title="{{localize 'PUBLIC_ACCESS.Moves.Edit'}}"><i class="fas fa-edit"></i></button>
                  <button type="button" class="item-delete" title="{{localize 'PUBLIC_ACCESS.Moves.Delete'}}"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <div class="move-description">{{{this.system.description}}}</div>
            </div>
            {{/each}}
            {{#unless moves.length}}
            <p class="no-items-hint">{{localize "PUBLIC_ACCESS.Moves.Empty"}}</p>
            {{/unless}}
          </div>

        </div>

        {{!-- ═══ NOTES TAB ═══ --}}
        <div class="tab notes" data-group="primary" data-tab="notes">

          <div class="section-header"><span>─── ★ {{localize "PUBLIC_ACCESS.Sections.Notes"}} ★ ───</span></div>
          <div class="notes-area">
            <textarea name="system.notes" placeholder="{{localize 'PUBLIC_ACCESS.Notes.Placeholder'}}">{{system.notes}}</textarea>
          </div>

        </div>

      </section>
    </div>

  </div>

  <div class="forum-signature">
    <div class="sig-separator">─── ✦ ─── ✦ ─── ✦ ───</div>
    <div class="sig-content">
      <em>「 {{localize "PUBLIC_ACCESS.Signature"}} 」</em>
    </div>
  </div>

</form>
