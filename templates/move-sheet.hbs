<form class="public-access sheet item move-sheet" autocomplete="off">

  <header class="forum-topbar">
    <div class="forum-logo compact">★ PUBLIC ACCESS ★</div>
    <div class="forum-nav">
      <span class="nav-link">{{localize "PUBLIC_ACCESS.Nav.Compendium"}}</span>
      <span class="nav-sep">»</span>
      <span class="nav-current">{{localize "PUBLIC_ACCESS.Nav.Move"}}</span>
    </div>
  </header>

  <div class="thread-title-bar">
    <span class="thread-icon">📄</span>
    <input class="thread-title-input" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'PUBLIC_ACCESS.MoveSheet.NamePlaceholder'}}" />
  </div>

  <div class="move-sheet-body">
    <div class="section-header"><span>★ {{localize "PUBLIC_ACCESS.Sections.Description"}} ★</span></div>
    <div class="move-editor">
      <textarea name="system.description" placeholder="{{localize 'PUBLIC_ACCESS.MoveSheet.DescriptionPlaceholder'}}">{{system.description}}</textarea>
    </div>
  </div>

  <div class="forum-signature">
    <div class="sig-separator">─── ✦ ───</div>
  </div>

</form>
